# Copy this file to .env.local and fill in the values
# Get the Supabase URL and keys from: pnpm supabase status (after pnpm start in apps/supabase)
# The anon key is labelled "Publishable" in newer Supabase CLI versions (sb_publishable_...)

EXPO_PUBLIC_SUPABASE_URL=http://localhost:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your-key-here

# Sentry DSN — get from sentry.io dashboard (project: lecolpo-mobile). Leave blank for local dev.
EXPO_PUBLIC_SENTRY_DSN=

# Sentry org slug — used by Expo plugin at build time
SENTRY_ORG=lecolpo

