# Copy this file to .env and fill in the values
# Get Google credentials from: console.cloud.google.com → APIs & Services → Credentials

SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=GOCSPX-your-google-client-secret

# Apple (only needed for production builds — not required for local dev)
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=

