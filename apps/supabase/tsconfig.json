{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["jest", "node"],
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "paths": {
      "https://esm.sh/@supabase/supabase-js@2": ["./node_modules/@supabase/supabase-js"]
    }
  },
  "include": ["supabase/tests/**/*.ts", "supabase/functions/_shared/**/*.ts", "supabase/functions/**/*.ts"]
}

